<Page x:Class="ApplicationApp.View.Pages.PageWarehouseProducts"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ApplicationApp.View.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PageWarehouseProducts">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="15" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="15" />
            <ColumnDefinition Width="0.2*" />
            <ColumnDefinition Width="15" />
        </Grid.ColumnDefinitions>
        <ListView x:Name="WarehouseProductsList"
          ItemsSource="{Binding WarehouseProducts}"
          SelectedItem="{Binding SelectedWarehouseProduct, Mode=TwoWay}" Grid.Column="1">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Gray" BorderThickness="1" Margin="2" Padding="5" CornerRadius="5">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="ID продукта на складе:" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Id}" />
                            <TextBlock Text="Количество:" FontWeight="Bold"/>
                            <TextBlock Text="{Binding CountProduct}" />
                            <TextBlock Text="ID Продукта:" FontWeight="Bold"/>
                            <TextBlock Text="{Binding ProductId}" />
                            <TextBlock Text="ID Склада:" FontWeight="Bold"/>
                            <TextBlock Text="{Binding WarehouseId}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <StackPanel Grid.Column="3">
            <Button Height="40" Width="120" Margin="0,10,0,10" Content="Добавить" Background="#2E2E2E" Click="OpenAddPage"/>
            <Button Height="40" Width="120" Margin="0,10,0,10" Content="Изменить" Background="#2E2E2E" Click="EtitOpenPage"/>
            <Button Height="40" Width="120" Margin="0,10,0,10" Content="Удалить" Background="#2E2E2E" Command="{Binding DeleteCommand}"/>
        </StackPanel>
    </Grid>
</Page>
