<Page x:Class="ApplicationApp.View.Pages.PageProductsWriteEdit"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ApplicationApp.View.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="620" d:DesignWidth="800"
      Title="PageProductsWriteEdit">

    <Grid>
        <StackPanel>
            <TextBlock TextWrapping="Wrap" Padding="5" Text="Название продукции"/>
            <TextBox x:Name="Name" TextWrapping="Wrap" Padding="5" Text="{Binding Name}" Width="800"/>

            <TextBlock TextWrapping="Wrap" Padding="5" Text="Id материала"/>
            <TextBox x:Name="MaterialId" TextWrapping="Wrap" Padding="5" Text="{Binding MaterialId}" Width="800"/>

            <TextBlock TextWrapping="Wrap" Padding="5" Text="Артикль"/>
            <TextBox x:Name="Articul" TextWrapping="Wrap" Padding="5" Text="{Binding Articul}" Width="800"/>

            <TextBlock TextWrapping="Wrap" Padding="5" Text="Минимальная цена"/>
            <TextBox x:Name="MinPrice" TextWrapping="Wrap" Padding="5" Text="{Binding MinPrice}" Width="800"/>

            <TextBlock TextWrapping="Wrap" Padding="5" Text="Изображение"/>
            <Button x:Name="ImagePath" Padding="5" Content="Выбрать изображение" Width="220" Command="{Binding SelectImageCommand}" Foreground="#FF000000" BorderBrush="#FFABADB3"  RenderTransformOrigin="0.5,0.5" />

            <TextBlock TextWrapping="Wrap" Padding="5" Text="Человек для производства" />
            <TextBox x:Name="PeopleMake" TextWrapping="Wrap" Padding="5" Text="{Binding PeopleMake}" Width="800"/>

            <TextBlock TextWrapping="Wrap" Padding="5" Text="Номер производства"/>
            <TextBox x:Name="ManafacturAdrres" TextWrapping="Wrap" Padding="5" Text="{Binding ManafacturAdrres}" Width="800"/>
            <Button Margin="10" Content="Сохранить" Command="{Binding SaveCommand}"/>
            <Button Margin="10" Content="Отмена" Click="Exit"/>
        </StackPanel>
    </Grid>
</Page>
