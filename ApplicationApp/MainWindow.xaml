<Window x:Class="ApplicationApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ApplicationApp"
        mc:Ignorable="d"
        Title="MainWindow" Height="690" Width="1200" Background="#E6F0F5">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="15" />
            <ColumnDefinition Width="0.3*" />
            <ColumnDefinition Width="15" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="18*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="0">
                <Image Width="Auto" Height="40" Source="Assets\Image\Z.png" Margin="0,7,0,0"/>
                <TextBlock VerticalAlignment="Center" Margin="5,0,0,0" Foreground="Red" FontWeight="Bold" FontSize="20" Text="ZакупО4ка" />
            </StackPanel>
            <StackPanel Grid.Column="1" Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Center">
                <Button Height="45" Width="250" Content="Агент" Background="#2E2E2E" FontSize="14" Margin="0,10,0,10"/>
                <Button Height="45" Width="250" Content="Материалы" Background="#2E2E2E" FontSize="14" Margin="0,10,0,10"/>
                <Button Height="45" Width="250" Content="Склады" Background="#2E2E2E" FontSize="14" Margin="0,10,0,10"/>
                <Button Height="45" Width="250" Content="Продукты" Background="#2E2E2E" FontSize="14" Margin="0,10,0,10"/>
                <Button Height="45" Width="250" Content="Продукты на складах" FontSize="14" Background="#2E2E2E" Margin="0,10,0,10"/>
                <Button Height="45" Width="250" Content="Продажи" Background="#2E2E2E" FontSize="14" Margin="0,10,0,80"/>

                <TextBlock Text="По всем вопросам обращайтесь к админу" FontSize="26" FontWeight="Bold" TextWrapping="WrapWithOverflow"/>
            </StackPanel>
        </Grid>
        <Frame x:Name="MainFrame" Grid.Column="3" NavigationUIVisibility="Hidden" />
    </Grid>
</Window>
